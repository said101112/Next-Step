# ============================================================
# NextStep — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=nextstep_user
POSTGRES_PASSWORD=password
POSTGRES_DB=nextstep_db

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB=keycloak_db
# "Sign in with Google" (Keycloak identity provider). Google Cloud Console >
# APIs & Services > Credentials > OAuth client 109489905512-... > Client secret.
# Authorized redirect URI there: http://localhost:8080/realms/Next-Step/broker/google/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keycloak emails (account linking, password reset) are sent from
# nextstep2032@gmail.com via smtp.gmail.com. Use a Gmail *App password*
# (Google Account > Security > 2-Step Verification > App passwords),
# not the normal account password.
SMTP_PASSWORD=

# --- Backend emails (Gmail connection) ---
# Separate from the two Keycloak values above: the backend sends application
# emails (follow-ups, replies) itself. Same Gmail app password, different keys.
# .NET binds these as Email__Smtp__* / GoogleOAuth__* (double underscore).
Email__Smtp__Host=smtp.gmail.com
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromEmail=
# Backend Gmail OAuth (connects a mailbox to a user profile).
# Authorized redirect URI: <PUBLIC_URL>/api/email-connections/google/callback
GoogleOAuth__ClientId=
GoogleOAuth__ClientSecret=

# --- Internal security ---
# Shared secret: the agents service rejects any request without it (only the backend may call it).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTS_API_KEY=

# --- Docker ---
# DB connection strings and service URLs are set by the compose files.
# Production only:
# Public address of the app (https:// in real prod) and the proxy's port
PUBLIC_URL=http://localhost
HTTP_PORT=80
# Pull prebuilt images from a registry instead of building on the server
# IMAGE_PREFIX=docker.io/<your-namespace>
# IMAGE_TAG=latest

# --- File storage ---
# Local = files on a Docker volume (default). Minio = S3 via the optional
# "minio" compose profile (needs MINIO_IMAGE, see docker-compose.yml).
STORAGE_MODE=Local
# MINIO_IMAGE=
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=change-me
# MINIO_PUBLIC_URL=http://localhost:9000

# --- LLM Global Configuration ---
# Priority order for fallback (e.g., "gemini,groq,openai")
LLM_PROVIDER_PRIORITY=groq,gemini,openai
LLM_TEMPERATURE=0.1

# Agent-specific priorities (Forces Gemini for these tasks)
LLM_PRIORITY_CV_OPTIMIZER=gemini,groq

# --- Groq (Fast & Free) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_PRECISE=openai/gpt-oss-120b

# --- Gemini (Google) ---
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- OpenAI (Optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Search API ---
TAVILY_API_KEY=

# --- Agent-Specific Overrides (Optional) ---
# Gemini overrides (e.g., gemini-2.0-flash or gemini-1.5-pro)
GEMINI_MODEL_CV_OPTIMIZER=gemini-flash-latest

# Groq overrides
GROQ_MODEL_CV_OPTIMIZER=openai/gpt-oss-120b
